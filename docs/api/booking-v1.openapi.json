          },
          "detail": {
            "title": "Detail"
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "Appointment": {
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "duration_min": {
            "title": "Duration Min",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "local_date": {
            "title": "Local Date",
            "type": "string"
          },
          "local_time": {
            "title": "Local Time",
            "type": "string"
          },
          "patient_id": {
            "title": "Patient Id",
            "type": "integer"
          },
          "patient_name": {
            "title": "Patient Name",
            "type": "string"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "start_at": {
            "title": "Start At",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "therapist_id": {
            "title": "Therapist Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "therapist_id",
          "patient_id",
          "patient_name",
          "start_at",
          "local_date",
          "local_time",
          "duration_min",
          "status",
          "source",
          "created_at"
        ],
        "title": "Appointment",
        "type": "object"
      },
      "AppointmentList": {
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/Appointment"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items",
          "count"
        ],
        "title": "AppointmentList",
        "type": "object"
      },
      "BookingIn": {
        "properties": {
          "duration_min": {
            "default": 60,
            "maximum": 60.0,
            "minimum": 60.0,
            "title": "Duration Min",
            "type": "integer"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          },
          "patient": {
            "$ref": "#/components/schemas/PatientIn"
          },
          "send_confirmation": {
            "default": true,
            "title": "Send Confirmation",
            "type": "boolean"
          },
          "source": {
            "default": "api",
            "enum": [
              "api",
              "telegram",
              "whatsapp",
              "manual"
            ],
            "title": "Source",
            "type": "string"
          },
          "start_at": {
            "format": "date-time",
            "title": "Start At",
            "type": "string"
          },
          "summary": {
            "default": "",
            "maxLength": 2000,
            "title": "Summary",
            "type": "string"
          },
          "therapist_id": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Therapist Id",
            "type": "string"
          }
        },
        "required": [
          "therapist_id",
          "start_at",
          "patient"
        ],
        "title": "BookingIn",
        "type": "object"
      },
      "PatientIn": {
        "properties": {
          "channel": {
            "anyOf": [
              {
                "enum": [
                  "telegram",
                  "whatsapp"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Channel"
          },
          "email": {
            "anyOf": [
              {
                "maxLength": 254,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "external_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Id"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "patient_id": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patient Id"
          },
          "phone": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          }
        },
        "required": [
          "name"
        ],
        "title": "PatientIn",
        "type": "object"
      },
      "Slot": {
        "properties": {
          "duration_min": {
            "title": "Duration Min",
            "type": "integer"
          },
          "local_date": {
            "title": "Local Date",
            "type": "string"
          },
          "local_time": {
            "title": "Local Time",
            "type": "string"
          },
          "start_at": {
            "title": "Start At",
            "type": "string"
          }
        },
        "required": [
          "start_at",
          "local_date",
          "local_time",
          "duration_min"
        ],
        "title": "Slot",
        "type": "object"
      },
