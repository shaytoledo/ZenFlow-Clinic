# ZenFlow Clinic — environment template. Copy to `.env` and fill in. NEVER commit `.env`.
#
# URL rule (security): every URL that is not localhost MUST use https://.
# Plain http:// is only acceptable for local development on localhost / 127.0.0.1.
# Outside dev (ENV != dev) the app refuses to start with http:// non-localhost URLs
# and with a default/missing SESSION_SECRET — see Phase 0.4 in docs/MASTER_PLAN_EN.md.

# --- Runtime ---
ENV=dev                                   # dev | staging | prod
# ZENFLOW_DB_PATH=data/zenflow.db         # SQLite file (default shown); tests override per test
LOG_FORMAT=auto                           # auto | console | json  (auto = console in dev, JSON otherwise)
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR

# --- Telegram ---
TELEGRAM_TOKEN=                           # patient bot token from @BotFather
THERAPIST_BOT_TOKEN=                      # therapist bot token (separate bot)
MESSAGING_CHANNEL=telegram                # telegram (whatsapp planned — Phase 7)

# --- AI ---
USE_AI=ollama                             # ollama | anthropic
OLLAMA_HOST=http://localhost:11434        # local only; use https:// for any remote Ollama
OLLAMA_MODEL=gemma3:latest
ANTHROPIC_API_KEY=                        # only when USE_AI=anthropic

# --- Redis ---
REDIS_URL=redis://localhost:6379/0        # use rediss:// (TLS) for any non-local Redis

# --- Web dashboard / secrets ---
SESSION_SECRET=                           # signs zf_session; >= 32 chars; generate: python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_ENCRYPTION_KEY=                     # Fernet material for stored Google tokens; MUST differ from SESSION_SECRET; required outside dev
                                          # existing installs: set it, then run  python -m zenflow.rotate_token_key --dry-run  (then without --dry-run)

# --- Google OAuth (Calendar + Gmail) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback                    # prod: https://<your-domain>/auth/callback
GOOGLE_REG_REDIRECT_URI=http://localhost:8000/register/google/callback     # prod: https://<your-domain>/register/google/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback        # prod: https://<your-domain>/auth/gmail/callback

# --- Feature flags (Phase 0.4; typed in zenflow/settings.py; every flag has both paths tested) ---
ZF_CLOUD=0                                # running on AWS (Phase 12)
ZF_STORAGE_S3=0                           # Storage ABC -> S3 (Phase 4.3 / 12)
ZF_QUEUE_BACKEND=inprocess                # inprocess | celery | temporal | aws (Phase 1.2 / 12)
ZF_CHANNEL_WHATSAPP=0                     # WhatsApp adapter (Phase 7.4)
ZF_AI_PROVIDER=                           # ollama | anthropic; empty = use USE_AI above
ZF_WEBHOOK_MODE=0                         # bots via webhooks instead of polling (Phase 12.2.5)
ZF_SSE_UPDATES=0                          # server-sent events instead of polling (Phase 3.4)
ZF_POINT_IMAGES=0                         # acupoint image store (Phase 4.3)
