# ZenFlow Clinic — environment template. Copy to `.env` and fill in. NEVER commit `.env`.
#
# FORMAT RULE: comments live on their own lines. python-dotenv treats text after an empty value
# (`KEY=   # note`) AS THE VALUE — a copied template would then sign sessions with the comment
# string. tests/security/test_auth_surface.py::test_env_example_parses_clean enforces this.
#
# URL rule (security, ADR-14): every URL that is not localhost MUST use https:// (rediss:// for
# Redis). Plain http:// is only for local development. Outside dev (ENV != dev) the app refuses
# to start with a non-localhost http:// URL, a default/short SESSION_SECRET, or a missing
# TOKEN_ENCRYPTION_KEY — see Phase 0.4 in docs/MASTER_PLAN_EN.md.

# ---------------------------------------------------------------- Runtime
# dev | test | staging | prod
ENV=dev
# SQLite file (default: data/zenflow.db). Tests override this per test.
#ZENFLOW_DB_PATH=data/zenflow.db
# auto | console | json   (auto = console in dev, JSON otherwise)
LOG_FORMAT=auto
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# IANA timezone of the clinic (drives "today", never the stored instants, which are UTC)
CLINIC_TZ=Asia/Jerusalem

# ---------------------------------------------------------------- Telegram
# Patient bot token from @BotFather
TELEGRAM_TOKEN=
# Therapist bot token (a separate bot)
THERAPIST_BOT_TOKEN=
# telegram (whatsapp arrives in Phase 7)
MESSAGING_CHANNEL=telegram
# Secret Telegram must echo on webhook calls (only with ZF_WEBHOOK_MODE; 1–256 of A-Z a-z 0-9 _ -)
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------- AI
# ollama | anthropic   (ZF_AI_PROVIDER below overrides when set)
USE_AI=ollama
# Local only; use https:// for any remote Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:latest
# Only when USE_AI=anthropic
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Redis
# Use rediss:// (TLS) for any non-local Redis
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- Web dashboard / secrets
# Signs the zf_session cookie. >= 32 chars. Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Fernet material for stored Google tokens. MUST differ from SESSION_SECRET; required outside dev.
# Existing installs: set it, then run  python -m zenflow.rotate_token_key --dry-run  (then for real).
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------- Google OAuth (Calendar + Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local dev server listens on 8080 (startup/run_web.py). Production: https://<your-domain>/...
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback
GOOGLE_REG_REDIRECT_URI=http://localhost:8080/register/google/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8080/auth/gmail/callback

# ---------------------------------------------------------------- Media (Phase 4.3b)
# Where LocalStorage keeps acupoint images; empty = data/media (git-ignored with data/)
MEDIA_ROOT=
# S3 store, used when ZF_STORAGE_S3=1 (Phase 4.3c). Objects are written with SSE-KMS; links are presigned.
# Credentials: the standard AWS chain (AWS_PROFILE / instance role) — never put keys in this file.
S3_BUCKET=
S3_PREFIX=media/
S3_REGION=
S3_KMS_KEY_ID=
# Only for an S3-compatible server such as MinIO; https:// outside dev
S3_ENDPOINT_URL=

# ---------------------------------------------------------------- Feature flags (Phase 0.4)
# Typed in zenflow/settings.py; every flag has both paths tested.
# running on AWS (Phase 12)
ZF_CLOUD=0
# Storage ABC -> S3 (Phase 4.3 / 12)
ZF_STORAGE_S3=0
# inprocess | celery | temporal | aws (Phase 1.2 / 12)
ZF_QUEUE_BACKEND=inprocess
# WhatsApp adapter (Phase 7.4)
ZF_CHANNEL_WHATSAPP=0
# ollama | anthropic; leave empty to use USE_AI above
ZF_AI_PROVIDER=
# bots via webhooks instead of polling (Phase 12.2.5)
ZF_WEBHOOK_MODE=0
# server-sent events instead of polling (Phase 3.4)
ZF_SSE_UPDATES=0
# show acupoint images on the treatment page (Phase 4.3; needs licensed images, Q4)
ZF_POINT_IMAGES=0
# Idle minutes before a patient's booking/intake/therapist-chat flow is closed; 0 = never (2.2d)
ZF_CONV_TIMEOUT_MINUTES=30
# 1 = a session never marked complete still gets the 24h check-in, sent 24 h after it ended
# (owner decision Q7; off until decided)
ZF_AUTO_FOLLOWUP=0
# Booking API (/api/v1) requests per minute per caller; 0 = no limit
ZF_API_RATE_PER_MINUTE=60
